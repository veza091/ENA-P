# =========================================================
# ENA-P — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# =========================================================

# --- Required ---
DISCORD_TOKEN=your_discord_bot_token_here
# MAIN_GEMINI_API_KEY (or the alias GEMINI_API_KEY)
MAIN_GEMINI_API_KEY=your_gemini_api_key_here
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Memory keys (optional) ---
# A separate key for memory work (defaults to MAIN_GEMINI_API_KEY)
MEMORY_GEMINI_API_KEY=
# Comma-separated keys, rotated on quota exhaustion
MEMORY_GEMINI_API_KEYS=

# --- Database ---
# Forced on automatically for Supabase URLs; set 1/true to force otherwise
DATABASE_SSL=true

# --- Web server ---
PORT=8080

# --- Group awareness (optional) ---
# Comma-separated channel IDs to archive (database only). Empty disables it.
WATCH_CHANNELS=

# --- Proactive messages ---
PROACTIVE_ENABLED=1
# 1 = log opportunities without sending (measurement only)
PROACTIVE_SHADOW=0

# --- Background memory extraction (optional) ---
GEMMA_BACKGROUND_ENABLED=1
GEMMA_MEMORY_MODEL=gemma-4-31b-it

# --- Optional layers (off by default) ---
EMBED_ENABLED=0
AFFECT_ENABLED=0

# --- Live voice (optional; also needs davey + PyNaCl and a voice channel) ---
LIVE_VOICE_ENABLED=1
VOICE_CHANNEL=

# --- Gemini relay (optional) ---
GEMINI_RELAY_URL=
GEMINI_RELAY_TOKEN=
